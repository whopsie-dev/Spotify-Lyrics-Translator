{
  "manifest_version": 3,
  "name": "Spotify Lyrics Translator",
  "version": "1.0.0",
  "description": "Shows translated lyrics under the original lines on the Spotify web player. Translations are cached locally.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spotify Lyrics Translator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
